<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/button_purpose_detail_close"
        android:background="@null"
        android:padding="24dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:contentDescription="@string/didomi_close"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/didomi_ic_round_close_24px"/>
    <io.didomi.ssl.view.mobile.HeaderView
        android:id="@+id/header_purpose_detail"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/scroll_purpose_detail"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="@dimen/didomi_content_max_width"/>
    <ScrollView
        android:scrollbarStyle="outsideOverlay"
        android:id="@+id/scroll_purpose_detail"
        android:paddingLeft="24dp"
        android:paddingRight="24dp"
        android:paddingBottom="100dp"
        android:scrollbars="vertical"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        app:layout_constraintBottom_toTopOf="@+id/save_purpose_detail"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/header_purpose_detail">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:isScrollContainer="true">
            <TextView
                android:id="@+id/text_purpose_detail_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_max="@dimen/didomi_content_max_width_without_padding"
                style="@style/DidomiScreenTitle"/>
            <TextView
                android:id="@+id/text_purpose_detail_description"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/text_purpose_detail_title"
                app:layout_constraintWidth_max="@dimen/didomi_content_max_width_without_padding"
                style="@style/DidomiDescriptiveText"/>
            <TextView
                android:id="@+id/text_purpose_detail_description_legal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/text_purpose_detail_description"
                app:layout_constraintWidth_max="@dimen/didomi_content_max_width_without_padding"
                style="@style/DidomiDescriptiveText"/>
            <include
                android:id="@+id/view_purpose_detail_illustrations"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/text_purpose_detail_description_legal"
                app:layout_constraintWidth_max="@dimen/didomi_content_max_width_without_padding"
                layout="@layout/didomi_view_purpose_illustrations"/>
            <androidx.constraintlayout.widget.Group
                android:id="@+id/group_purpose_detail_consent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:constraint_referenced_ids="text_purpose_detail_consent_title,switch_purpose_detail_consent,view_purpose_detail_consent_divider"/>
            <TextView
                android:id="@+id/text_purpose_detail_consent_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:layout_constraintEnd_toStartOf="@+id/button_purpose_detail_consent_vendors_count"
                app:layout_constraintLeft_toLeftOf="@+id/text_purpose_detail_title"
                app:layout_constraintRight_toLeftOf="@+id/button_purpose_detail_consent_vendors_count"
                app:layout_constraintStart_toStartOf="@+id/text_purpose_detail_title"
                app:layout_constraintTop_toBottomOf="@+id/view_purpose_detail_illustrations"
                style="@style/DidomiHeaderSmall"/>
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/button_purpose_detail_consent_vendors_count"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="4dp"
                android:layout_marginEnd="4dp"
                app:layout_constraintBottom_toBottomOf="@+id/text_purpose_detail_consent_title"
                app:layout_constraintEnd_toStartOf="@+id/switch_purpose_detail_consent"
                app:layout_constraintLeft_toRightOf="@+id/text_purpose_detail_consent_title"
                app:layout_constraintRight_toLeftOf="@+id/switch_purpose_detail_consent"
                app:layout_constraintStart_toEndOf="@+id/text_purpose_detail_consent_title"
                app:layout_constraintTop_toTopOf="@+id/text_purpose_detail_consent_title"
                style="@style/DidomiCountDetail"/>
            <io.didomi.ssl.view.mobile.DidomiToggle
                android:layout_gravity="center"
                android:id="@+id/switch_purpose_detail_consent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="@+id/text_purpose_detail_consent_title"
                app:layout_constraintEnd_toEndOf="@+id/text_purpose_detail_title"
                app:layout_constraintLeft_toRightOf="@+id/button_purpose_detail_consent_vendors_count"
                app:layout_constraintRight_toRightOf="@+id/text_purpose_detail_title"
                app:layout_constraintStart_toEndOf="@+id/button_purpose_detail_consent_vendors_count"
                app:layout_constraintTop_toTopOf="@+id/text_purpose_detail_consent_title"/>
            <View
                android:id="@+id/view_purpose_detail_consent_divider"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_marginTop="20dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/text_purpose_detail_consent_title"
                app:layout_constraintWidth_max="@dimen/didomi_content_max_width_without_padding"/>
            <androidx.constraintlayout.widget.Group
                android:id="@+id/group_purpose_detail_legitimate_interest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:constraint_referenced_ids="text_purpose_detail_legitimate_interest_title,switch_purpose_detail_legitimate_interest,view_purpose_detail_legitimate_interest_divider"/>
            <TextView
                android:id="@+id/text_purpose_detail_legitimate_interest_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:layout_constraintEnd_toStartOf="@+id/button_purpose_detail_legitimate_interest_vendors_count"
                app:layout_constraintLeft_toLeftOf="@+id/text_purpose_detail_title"
                app:layout_constraintRight_toLeftOf="@+id/button_purpose_detail_legitimate_interest_vendors_count"
                app:layout_constraintStart_toStartOf="@+id/text_purpose_detail_title"
                app:layout_constraintTop_toBottomOf="@+id/view_purpose_detail_consent_divider"
                style="@style/DidomiHeaderSmall"/>
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/button_purpose_detail_legitimate_interest_vendors_count"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="4dp"
                android:layout_marginEnd="4dp"
                app:layout_constraintBottom_toBottomOf="@+id/text_purpose_detail_legitimate_interest_title"
                app:layout_constraintEnd_toStartOf="@+id/switch_purpose_detail_legitimate_interest"
                app:layout_constraintLeft_toRightOf="@+id/text_purpose_detail_legitimate_interest_title"
                app:layout_constraintRight_toLeftOf="@+id/switch_purpose_detail_legitimate_interest"
                app:layout_constraintStart_toEndOf="@+id/text_purpose_detail_legitimate_interest_title"
                app:layout_constraintTop_toTopOf="@+id/text_purpose_detail_legitimate_interest_title"
                style="@style/DidomiCountDetail"/>
            <io.didomi.ssl.view.mobile.DidomiToggle
                android:id="@+id/switch_purpose_detail_legitimate_interest"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:didomi_has_middle_state="false"
                app:layout_constraintBottom_toBottomOf="@+id/text_purpose_detail_legitimate_interest_title"
                app:layout_constraintEnd_toEndOf="@+id/text_purpose_detail_title"
                app:layout_constraintLeft_toRightOf="@+id/button_purpose_detail_legitimate_interest_vendors_count"
                app:layout_constraintRight_toRightOf="@+id/text_purpose_detail_title"
                app:layout_constraintStart_toEndOf="@+id/button_purpose_detail_legitimate_interest_vendors_count"
                app:layout_constraintTop_toTopOf="@+id/text_purpose_detail_legitimate_interest_title"/>
            <View
                android:id="@+id/view_purpose_detail_legitimate_interest_divider"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_marginTop="20dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/text_purpose_detail_legitimate_interest_title"
                app:layout_constraintWidth_max="@dimen/didomi_content_max_width_without_padding"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
    <View
        android:id="@+id/view_purpose_detail_bottom_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        app:layout_constraintBottom_toTopOf="@+id/save_purpose_detail"/>
    <io.didomi.ssl.purpose.mobile.PurposeSaveView
        android:id="@+id/save_purpose_detail"
        android:layout_width="0dp"
        android:layout_height="@dimen/didomi_bottom_height"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/scroll_purpose_detail"
        app:layout_constraintWidth_max="@dimen/didomi_content_max_width"/>
</androidx.constraintlayout.widget.ConstraintLayout>
